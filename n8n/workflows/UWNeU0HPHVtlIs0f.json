      "parameters": {
        "jsCode": "// Build the alert from the Error Trigger's data and escape it for Telegram's HTML mode.\nconst d = $input.first().json;\nconst esc = s => String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst wf = d.workflow?.name || 'unknown workflow';\nconst node = d.execution?.lastNodeExecuted || d.trigger?.error?.node?.name || 'unknown node';\nconst msg = d.execution?.error?.message || d.trigger?.error?.message || 'no error message';\nconst when = $now.setZone('Europe/Luxembourg').toFormat('dd LLL yyyy, HH:mm');\nconst text = [\n  '<b>Internship Radar: a workflow failed</b>',\n  `Workflow: ${esc(wf)}`,\n  `Node: ${esc(node)}`,\n  `Error: ${esc(msg).slice(0, 1500)}`,\n  `When: ${when}`,\n  d.execution?.id ? `Execution id: ${esc(d.execution.id)}` : '',\n].filter(Boolean).join('\\n');\nreturn [{ json: { chat_id: '7511678484', text } }];"
      },
      "name": "Build alert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
