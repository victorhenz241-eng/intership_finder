    {
      "parameters": {
        "jsCode": "// Runs after the Sweep workflow finished. Sweep's last step returns the rows it inserted,\n// so the number of items with an id = the number of new roles.\nconst chat_id = $('Parse command').first().json.chat_id;\nconst rows = $input.all().map(i => i.json).filter(r => r && (r.id || r.external_id));\nconst strong = rows.filter(r => r.severity === 'strong');\nlet text;\nif (!rows.length) {\n  text = 'Sweep finished: no new roles this time (everything in the listings is already in your table).';\n} else {\n  const top = strong.filter(r => r.company).sort((a, b) => (b.fit_score ?? 0) - (a.fit_score ?? 0)).slice(0, 3)\n    .map(r => `• ${r.company} — ${r.title} (${r.fit_score ?? '?'})`);\n  text = `Sweep finished: ${rows.length} new role(s), ${strong.length} strong.` +\n    (top.length ? `\\n\\nTop strong:\\n${top.join('\\n')}` : '') +\n    '\\n\\nSend /today to see them all.';\n}\nreturn [{ json: { chat_id, text } }];"
      },
      "name": "Sweep summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
