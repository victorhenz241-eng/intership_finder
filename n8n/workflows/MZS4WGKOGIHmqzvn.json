    {
      "parameters": {
        "jsCode": "// Keep primaries only (duplicates are folded behind one row), best score first.\nconst chat_id = $('Parse command').first().json.chat_id;\nconst rows = $input.all().map(i => i.json)\n  .filter(r => r.id && (r.dedup_group == null || r.dedup_group === r.id));\nif (!rows.length) {\n  return [{ json: { chat_id, text: 'No new strong roles in the last 24 hours.' } }];\n}\nrows.sort((a, b) => (b.fit_score ?? 0) - (a.fit_score ?? 0));\nconst lines = rows.slice(0, 15).map((r, i) =>\n  `${i + 1}. ${r.company} — ${r.title} (${r.fit_score ?? '?'})\\n${r.location || ''}\\n${r.url || ''}`);\nconst more = rows.length > 15 ? `\\n\\n…and ${rows.length - 15} more in the app.` : '';\nreturn [{ json: { chat_id, text: `${rows.length} strong new role(s) in the last 24 h:\\n\\n${lines.join('\\n\\n')}${more}` } }];"
      },
      "name": "Format /today",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ],
      "id": "3f9496c8-7e12-4931-b30b-ac64815e7a69"
    },
    {
      "parameters": {
        "jsCode": "const { chat_id, arg } = $('Parse command').first().json;\nif (!arg) {\n  return [{ json: { chat_id, text: 'Usage: /role <company>, e.g. /role Netflix' } }];\n}\nconst rows = $input.all().map(i => i.json)\n  .filter(r => r.id && (r.dedup_group == null || r.dedup_group === r.id));\nif (!rows.length) {\n  return [{ json: { chat_id, text: `No roles found for \"${arg}\".` } }];\n}\nrows.sort((a, b) => (b.fit_score ?? 0) - (a.fit_score ?? 0));\nconst lines = rows.slice(0, 10).map(r =>\n  `• ${r.company} — ${r.title}\\n  ${r.severity || 'unscored'} ${r.fit_score ?? ''} · stage: ${r.stage || '?'} · eligibility: ${r.eligibility || 'unknown'}\\n  ${r.url || ''}`);\nreturn [{ json: { chat_id, text: `${rows.length} role(s) matching \"${arg}\":\\n\\n${lines.join('\\n\\n')}` } }];"
      },
