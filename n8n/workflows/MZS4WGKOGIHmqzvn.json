    {
      "parameters": {
        "jsCode": "// Telegram parses the text as HTML, so escape & < > (job titles and URLs contain\n// characters that would otherwise break the message). Then split into pieces under\n// Telegram's 4,096-character limit, cutting only at line breaks so no link is split.\nconst esc = s => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst out = [];\nfor (const item of $input.all()) {\n  const { chat_id, text } = item.json;\n  let piece = '';\n  for (const line of esc(String(text || '(empty reply)')).split('\\n')) {\n    if (piece && piece.length + line.length + 1 > 4000) { out.push({ json: { chat_id, text: piece } }); piece = ''; }\n    piece = piece ? piece + '\\n' + line : line.slice(0, 4000);\n  }\n  if (piece) out.push({ json: { chat_id, text: piece } });\n}\nreturn out;"
      },
