# Supabase project URL (Project Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable (anon) key (Project Settings → API Keys → Publishable key)
# The app reads and updates the `roles` table with this key under RLS. It never inserts or deletes.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Server-only (no NEXT_PUBLIC_ prefix): used by /api/draft, never shipped to the browser.
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx
# Optional. The only email allowed to call /api/draft (defaults to the owner email in the RLS migration).
# OWNER_EMAIL=you@example.com
